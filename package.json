{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.1",
    "typescript": "~5.9.2"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "uuid": "11.1.1",
      "fast-uri": "3.1.5",
      "form-data": "2.5.6",
      "linkify-it": "5.0.2",
      "protobufjs": "7.6.5",
      "ws": "8.21.0",
      "qs": "6.15.2",
      "fast-xml-builder": "1.1.9",
      "@tootallnate/once": "2.0.1",
      "esbuild": "0.28.1",
      "js-yaml": "4.3.1",
      "markdown-it": "14.2.0",
      "@babel/core": "7.29.6",
      "ip-address": "10.3.1",
      "brace-expansion": "2.1.4",
      "nanoid": "3.3.18",
      "postcss": "8.5.23",
      "body-parser": "2.3.0"
    }
  },
  "dependencies": {}
}