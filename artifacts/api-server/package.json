{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke:import-helpers": "tsx src/scripts/importHelpers.smoke.ts",
    "smoke:slug-concurrency": "tsx src/scripts/entrySlugConcurrency.smoke.ts",
    "smoke:duplicate-location-repair": "tsx src/scripts/duplicateLocationRepair.smoke.ts",
    "smoke:local-seo-state": "tsx src/scripts/localSeoStateNormalization.smoke.ts",
    "smoke:lesson-guides": "tsx src/scripts/lessonGuideSeo.smoke.ts",
    "smoke:listing-seo": "tsx src/scripts/listingSeo.smoke.ts",
    "smoke:soft-404": "tsx src/scripts/soft404.smoke.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@google/genai": "^1.50.1",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/integrations-gemini-ai": "workspace:*",
    "@workspace/lesson-guides": "workspace:*",
    "@workspace/listing-seo": "workspace:*",
    "@workspace/public-route-status": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.6.2",
    "nodemailer": "^9.0.3",
    "openid-client": "^6.8.4",
    "pino": "^9",
    "pino-http": "^10"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.1",
    "esbuild": "^0.27.3",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
